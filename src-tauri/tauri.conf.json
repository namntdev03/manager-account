{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manager Account",
  "version": "0.2.3",
  "identifier": "com.nguyenthanhnam.manageraccount",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Manager Account",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Chuyển nhanh giữa nhiều tài khoản Git",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzRDRFRTNEMEM3Q0NDRDIKUldUU3pId01QZTdVb3lmLzdWa0lHMjlGZm44Zy9LanhWS3hTYUpZWVFCdWtYTXg3UDBKZUQxVWMK",
      "endpoints": [
        "https://github.com/namntdev03/manager-account/releases/latest/download/latest.json"
      ]
    }
  }
}
