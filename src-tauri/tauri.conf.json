{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manager Account",
  "version": "0.1.0",
  "identifier": "com.nguyenthanhnam.manageraccount",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Manager Account - Git",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Chuyển nhanh giữa nhiều tài khoản Git",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
